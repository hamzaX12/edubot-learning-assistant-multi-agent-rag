<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/edubot/db" VERSION="2025010100" COMMENT="XMLDB file for local_edubot"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>

    <TABLE NAME="local_edubot_conversations" COMMENT="EduBot chat conversations">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Moodle user ID"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Moodle course ID"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Auto-generated from first message"/>
        <FIELD NAME="topic" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Current topic being discussed"/>
        <FIELD NAME="created_at" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Unix timestamp"/>
        <FIELD NAME="updated_at" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Unix timestamp"/>
        <FIELD NAME="conversation_type" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="chat" SEQUENCE="false" COMMENT="chat or quiz_debrief"/>
        <FIELD NAME="context_data" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON encoded state"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_userid" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="idx_courseid" UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="idx_userid_courseid" UNIQUE="false" FIELDS="userid, courseid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_edubot_messages" COMMENT="EduBot chat messages">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="conversation_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="FK to conversations"/>
        <FIELD NAME="role" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="user or assistant"/>
        <FIELD NAME="content" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Message content"/>
        <FIELD NAME="strategy_used" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false" COMMENT="Pedagogical strategy applied"/>
        <FIELD NAME="emotion_detected" TYPE="char" LENGTH="30" NOTNULL="false" SEQUENCE="false" COMMENT="Detected emotional state"/>
        <FIELD NAME="created_at" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Unix timestamp"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_conversation" TYPE="foreign" FIELDS="conversation_id" REFTABLE="local_edubot_conversations" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_conversation_id" UNIQUE="false" FIELDS="conversation_id"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_edubot_student_profiles" COMMENT="Student learning profiles">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Moodle user ID"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Moodle course ID"/>
        <FIELD NAME="processing_style" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false" COMMENT="Active or Reflective"/>
        <FIELD NAME="perception_style" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false" COMMENT="Sensing or Intuitive"/>
        <FIELD NAME="input_style" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false" COMMENT="Visual or Verbal"/>
        <FIELD NAME="understanding_style" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false" COMMENT="Sequential or Global"/>
        <FIELD NAME="style_confidence" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="Detection confidence 0 to 1"/>
        <FIELD NAME="updated_at" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Unix timestamp"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_userid_courseid" UNIQUE="true" FIELDS="userid, courseid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_edubot_rag_chunks" COMMENT="RAG text chunks from course resources">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Moodle course ID"/>
        <FIELD NAME="resource_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Moodle resource ID"/>
        <FIELD NAME="resource_name" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="chunk_text" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Extracted text chunk"/>
        <FIELD NAME="chunk_index" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Position in document"/>
        <FIELD NAME="page_number" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="1" SEQUENCE="false" COMMENT="PDF page number (1-indexed)"/>
        <FIELD NAME="embedding" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Vector embedding as JSON array of 768 floats"/>
        <FIELD NAME="created_at" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Unix timestamp"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_courseid" UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="idx_resource_id" UNIQUE="false" FIELDS="resource_id"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
